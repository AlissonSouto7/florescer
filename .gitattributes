# Normalize line endings across the repo
* text=auto

# Shell scripts must keep LF (break on CRLF)
*.sh text eol=lf
mvnw text eol=lf

# Windows scripts keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.jar binary
