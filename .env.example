# Variáveis de ambiente exigidas pelos dois serviços.
#
# Copie para .env (que é ignorado pelo git) e preencha com valores locais.
# Nenhuma destas variáveis tem valor padrão no código: sem elas a aplicação
# falha no boot, de propósito. Subir com uma configuração de mentira é pior
# que não subir.

# --- Banco de dados ------------------------------------------------------
# auth-service usa MySQL, product-service usa PostgreSQL. Cada serviço lê o
# par abaixo do seu próprio ambiente.
DB_USERNAME=florescer
DB_PASSWORD=troque-por-um-valor-aleatorio

# Só o docker-compose do auth-service usa esta:
DB_ROOT_PASSWORD=troque-por-um-valor-aleatorio

# --- Par de chaves RSA (assinatura dos JWTs) -----------------------------
# O auth-service assina com a privada; o product-service valida com a pública.
#
# Gere um par novo com:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out app.key
#   openssl rsa -pubout -in app.key -out app.pub
#
# Guarde os arquivos FORA do repositório. Em desenvolvimento aponte para eles:
RSA_PRIVATE_KEY=file:/caminho/absoluto/para/app.key
RSA_PUBLIC_KEY=file:/caminho/absoluto/para/app.pub
#
# Em produção, entregue o conteúdo PEM em si, vindo de um secret manager:
# o arquivo inteiro, das linhas de BEGIN até END. Quebras de linha podem ir
# escapadas como \n em uma linha só, porque o código normaliza antes de ler.
#
# O product-service precisa apenas da RSA_PUBLIC_KEY.

# --- Emissor esperado do token -------------------------------------------
# O product-service recusa tokens de outro emissor. Só mude se o auth-service
# passar a se identificar de outra forma.
JWT_ISSUER=auth-service

# --- Admin inicial (apenas desenvolvimento) ------------------------------
# Ainda não implementado: hoje o AdminInitializer tem credenciais fixas no
# código. Ver issue #3.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
