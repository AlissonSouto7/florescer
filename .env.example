# Variáveis de ambiente exigidas pelos dois serviços.
#
# Copie para .env (que é ignorado pelo git) e preencha com valores locais.
# Nenhuma destas variáveis tem valor padrão no código: sem elas a aplicação
# falha no boot, de propósito. Subir com uma configuração de mentira é pior
# que não subir.

# --- Banco de dados ------------------------------------------------------
# auth-service usa MySQL, product-service usa PostgreSQL. Cada serviço lê o
# par abaixo do seu próprio ambiente.
DB_USERNAME=florescer
DB_PASSWORD=troque-por-um-valor-aleatorio

# Só o docker-compose do auth-service usa esta:
DB_ROOT_PASSWORD=troque-por-um-valor-aleatorio

# --- Par de chaves RSA (assinatura dos JWTs) -----------------------------
# O auth-service assina com a privada; o product-service valida com a pública.
#
# Gere um par novo com:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out app.key
#   openssl rsa -pubout -in app.key -out app.pub
#
# Guarde os arquivos FORA do repositório. Em desenvolvimento aponte para eles:
RSA_PRIVATE_KEY=file:/caminho/absoluto/para/app.key
RSA_PUBLIC_KEY=file:/caminho/absoluto/para/app.pub
#
# Em produção, entregue o conteúdo PEM em si, vindo de um secret manager:
# o arquivo inteiro, das linhas de BEGIN até END. Quebras de linha podem ir
# escapadas como \n em uma linha só, porque o código normaliza antes de ler.
#
# O product-service precisa apenas da RSA_PUBLIC_KEY, e nem dela se usar JWKS.

# --- Descoberta da chave por JWKS (preferido) ----------------------------
# Aponta o product-service para o endpoint de chaves do auth-service. Quando
# preenchida, esta variável tem precedência sobre a RSA_PUBLIC_KEY e a troca de
# chave passa a valer sem redeploy: o serviço busca a chave nova pelo kid do
# token. Deixe em branco para continuar com a chave fixa acima.
#
# Local:  JWT_JWKS_URI=http://localhost:8080/.well-known/jwks.json
# Docker: JWT_JWKS_URI=http://auth-service:8080/.well-known/jwks.json
JWT_JWKS_URI=

# --- Emissor esperado do token -------------------------------------------
# O product-service recusa tokens de outro emissor. Só mude se o auth-service
# passar a se identificar de outra forma.
JWT_ISSUER=auth-service

# --- Origens permitidas pelo navegador (CORS) ----------------------------
# Lista separada por vírgula, sem curinga: liberar qualquer origem permitiria
# que outro site chamasse estas APIs em nome de quem está navegando.
# Vazio usa o padrão de desenvolvimento (localhost:3000, :5500 e 127.0.0.1:5500).
CORS_ALLOWED_ORIGINS=

# --- Salt do pseudônimo de log -------------------------------------------
# O log registra tentativas de autenticação e autoria de escrita por um
# pseudônimo, nunca pelo e-mail. Este salt é o que impede alguém com o log e uma
# lista de candidatos de testar hipóteses até descobrir de quem é cada registro.
#
# Precisa ser o MESMO entre reinícios, senão o pseudônimo muda e a auditoria
# perde a linha do tempo. Trocar o salt é equivalente a apagar a correlação
# histórica. Gere uma vez e guarde:
#   openssl rand -hex 32
#
# Sem valor o pseudônimo continua funcionando, só perde essa resistência.
LOG_PSEUDONYM_SALT=

# --- Admin inicial -------------------------------------------------------
# Desligado por padrão. Ligue apenas no primeiro boot de um ambiente novo e
# desligue depois: uma conta administrativa que se recria a cada subida é uma
# porta que nunca fecha.
#
# Sem valor padrão de propósito. Senha padrão em código é conta conhecida por
# qualquer pessoa que leia o repositório.
ADMIN_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Diretório das imagens de produto ------------------------------------
# Fora do jar de propósito: dentro do artefato, toda imagem some no próximo
# deploy e o banco fica apontando para arquivo que não existe mais.
UPLOADS_DIR=uploads

# --- Perfil ativo --------------------------------------------------------
# dev  = log colorido no terminal, SQL visível
# prod = log em JSON por linha, para agregador
SPRING_PROFILES_ACTIVE=dev
