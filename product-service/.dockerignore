# Build acontece dentro da imagem: nada de artefato local no contexto.
target/
.mvn/wrapper/*.jar

# Uploads são dados de runtime, ficam em volume.
uploads/

# Nunca enviar segredo para o contexto de build.
*.key
*.pem
.env

# Lixo de IDE e SO
.settings/
.project
.classpath
.factorypath
.idea/
*.iml
.DS_Store
Thumbs.db

# Docs e infra não entram na imagem
Dockerfile
.dockerignore
docker/
*.md
